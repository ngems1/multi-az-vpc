# Copy to backend.tf and adjust. Use one state key per environment, e.g.:
#   terraform init -backend-config="key=network/dev/terraform.tfstate"
#
# Requires Terraform >= 1.10 for S3-native state locking (use_lockfile).
# On older versions replace `use_lockfile` with `dynamodb_table = "<lock-table>"`.

terraform {
  backend "s3" {
    bucket       = "acme-terraform-state-123456789012"
    key          = "network/dev/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
